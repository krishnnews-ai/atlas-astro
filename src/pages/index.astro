---
import Layout from '../layouts/Layout.astro';
import { posts } from '../lib/content';

// Atlas theme ki dummy posts filtering
const DUMMY_SLUGS = [
  'blog-post',
  'coconut-curry-soup-with-chickpeas',
  'dark-chocolate-self-saucing-pudding',
  'delicious-chicken-meatball-soup',
  'fairy-potion-summer-fruit-drink',
  'fashion-tips-trends-and-celebrity-style',
  'fruit-yogurt-easy-homemade-fruit-drink',
  'healthy-chicken-and-rice-soup',
  'melt-and-mix-chocolate-and-ginger-mud-cake',
  'pecan-chocolate-bread-and-butter',
  'refreshing-summer-fruit-drink',
  'spicy-crispy-chicken-burger-recipe',
  'spiked-strawberry-slushies-for-a-crowd',
  'tomato-bisque-with-fried-cheese',
  'tortellini-soup-with-italian-sausage-and-kale',
  'vegan-chocolate-avocado-milkshakes',
  'wild-mushroom-chowder-with-leeks',
  'why-do-restaurant-burgers-taste-better',
  'a-mild-sweet-fruit-with-a-fibrous-center',
  'always-keep-your-drone-within-the-vlos',
  'comfortable-pairs-of-sneakers-to-walk-all-day',
  'essential-tech-tips-for-your-business',
  'finally-found-a-work-computer-setup-thats-practically-perfect',
  'for-good-results-must-be-make-good-plan',
  'gadgets-that-will-upgrade-your-home',
  'headsets-are-better-if-youre-playing-games',
  'hot-new-releases-in-audio-headphones',
  'how-to-do-the-superman-standing-exercise',
  'how-to-organize-and-write-content-for',
  'in-fact-certainly-influenced-seldes-the-leftist-journalist-i-f-stone',
  'laptops-tend-to-be-smaller-than-desktops',
  'laugh-cry-and-learn-within-virtual-reality',
  'make-your-gaming-setup-look-better',
  'make-your-phone-feel-new-again',
  'mistakes-you-might-be-making-with-your-watch',
  'mobile-camera-makes-a-huge-leap-in-quality',
  'rugby-african-ations-are-singing-to-save-their-wildlif',
  'surprising-benefits-of-honeydew-melon',
  'the-inbound-marketing-methodology-method-of-drawing-the-right',
  'the-secret-of-buzzfeeds-success-has-a-lot-to-do-with-the-image-heavy',
  'there-are-several-differences-between-outbound',
  'tips-to-ensure-you-always-look-stylish',
  'top-12-health-benefits-of-eating-grapes',
  'top-classic-style-inspiration-ideas',
  'top-mens-fashion-trends-from-spring',
  'vr-headset-virtual-reality-glasses',
  'will-humans-be-able-to-live-in-mars-in-the-future',
  'winter-dressing-tips-when-its-really-cold-out',
  'contact',
  'privacy-policy'
];

const cleanPosts = posts.filter((p: any) => !DUMMY_SLUGS.includes(p.slug));
const allPosts = cleanPosts.slice().reverse();
const heroMain = allPosts[0];
const heroSide = allPosts.slice(1, 5);
const trendingPosts = allPosts.slice(5, 11);
const latestPosts = allPosts.slice(11, 31);

// Category groups
const catGroups: Record<string, any[]> = {};
const catOrder = ['Market News', 'Trending News', 'Crypto Regulations', 'Crypto'];

for (const cat of catOrder) {
  const catPosts = allPosts.filter((p) =>
    p.categories?.some((c: string) => c.toLowerCase() === cat.toLowerCase())
  );
  if (catPosts.length >= 3) {
    catGroups[cat] = catPosts.slice(0, 6);
  }
}

const today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

// Post HTML se pehli image nikaalo
const POST_HTML = import.meta.glob('../generated/posts/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

function getPostImage(slug: string): string {
  const key = Object.keys(POST_HTML).find((k) => k.endsWith('/' + slug + '.html'));
  if (!key) return '';
  const html = POST_HTML[key];
  const match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
  return match ? match[1] : '';
}
---

<Layout
  title="Coin AI News | Latest Crypto, Bitcoin & AI News"
  description="Coin AI News delivers the latest news, market analysis, and updates on Bitcoin, Ethereum, Altcoins, and Crypto Regulations."
  bodyClass="home-magazine"
  css="home-default"
  js="home-default"
  dir="ltr"
>
  <style is:inline>
    .magazine-wrap { max-width: 1280px; margin: 0 auto; padding: 24px 20px; font-family: Poppins, -apple-system, sans-serif; background: #fff; }
    .mag-topbar { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; font-size: 13px; color: #666; margin-bottom: 24px; }
    .mag-topbar .socials a { color: #666; margin-left: 14px; text-decoration: none; font-weight: 600; }
    .mag-topbar .socials a:hover { color: #0066cc; }

    .mag-ticker { background: #111; color: #fff; padding: 10px 20px; border-radius: 6px; margin-bottom: 30px; display: flex; align-items: center; gap: 16px; overflow: hidden; }
    .mag-ticker .ticker-label { background: #ff6b00; padding: 4px 12px; border-radius: 3px; font-size: 11px; font-weight: 700; text-transform: uppercase; flex-shrink: 0; z-index: 2; }
    .mag-ticker .ticker-track { display: flex; gap: 40px; white-space: nowrap; animation: scrollTicker 40s linear infinite; }
    .mag-ticker .ticker-track a { color: #fff; text-decoration: none; font-size: 13px; }
    .mag-ticker .ticker-track a:hover { color: #ff6b00; }
    @keyframes scrollTicker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .mag-section-title { font-size: 20px; font-weight: 700; color: #111; margin: 0 0 18px; padding-bottom: 10px; border-bottom: 2px solid #111; display: flex; align-items: center; justify-content: space-between; }
    .mag-section-title a { font-size: 12px; font-weight: 500; color: #0066cc; text-decoration: none; }

    .mag-hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; margin-bottom: 40px; }
    @media (max-width: 900px) { .mag-hero { grid-template-columns: 1fr; } }

    .mag-hero-main { position: relative; border-radius: 8px; overflow: hidden; background: #f5f5f5; }
    .mag-hero-main a { display: block; color: #fff; text-decoration: none; }
    .mag-hero-main .hero-img { width: 100%; height: 400px; object-fit: cover; display: block; }
    .mag-hero-main .hero-content { padding: 32px 28px 28px; background: linear-gradient(transparent, rgba(0,0,0,0.9)); margin-top: -140px; position: relative; }
    .mag-hero-main .hero-cat { display: inline-block; background: #ff6b00; color: #fff; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 3px; margin-bottom: 12px; text-transform: uppercase; }
    .mag-hero-main h2 { font-size: 26px; font-weight: 700; margin: 0 0 10px; line-height: 1.3; }
    .mag-hero-main .hero-date { font-size: 12px; opacity: 0.85; }

    .mag-hero-side { display: grid; gap: 14px; }
    .mag-hero-side article { display: flex; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid #f0f0f0; }
    .mag-hero-side article:last-child { border-bottom: 0; }
    .mag-hero-side .side-thumb { width: 90px; height: 90px; flex-shrink: 0; border-radius: 6px; overflow: hidden; background: #f0f0f0; }
    .mag-hero-side .side-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .mag-hero-side .side-content { flex: 1; }
    .mag-hero-side .side-cat { font-size: 10px; color: #ff6b00; font-weight: 600; text-transform: uppercase; }
    .mag-hero-side h3 { font-size: 14px; font-weight: 600; margin: 4px 0 6px; line-height: 1.4; }
    .mag-hero-side h3 a { color: #111; text-decoration: none; }
    .mag-hero-side h3 a:hover { color: #0066cc; }
    .mag-hero-side .side-date { font-size: 11px; color: #999; }

    .mag-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .mag-card { background: #fff; border: 1px solid #f0f0f0; border-radius: 8px; overflow: hidden; transition: box-shadow 0.2s; }
    .mag-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .mag-card .card-thumb { height: 180px; overflow: hidden; background: #f0f0f0; }
    .mag-card .card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .mag-card:hover .card-thumb img { transform: scale(1.05); }
    .mag-card .card-body { padding: 18px; }
    .mag-card .card-cat { font-size: 10px; color: #ff6b00; font-weight: 600; text-transform: uppercase; }
    .mag-card h3 { font-size: 15px; font-weight: 600; margin: 6px 0 10px; line-height: 1.4; }
    .mag-card h3 a { color: #111; text-decoration: none; }
    .mag-card h3 a:hover { color: #0066cc; }
    .mag-card .card-date { font-size: 11px; color: #999; }

    .mag-layout-2col { display: grid; grid-template-columns: 1fr 320px; gap: 40px; }
    @media (max-width: 900px) { .mag-layout-2col { grid-template-columns: 1fr; } }

    .mag-sidebar-widget { background: #fafafa; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
    .mag-sidebar-widget h4 { font-size: 15px; font-weight: 700; margin: 0 0 14px; color: #111; padding-bottom: 10px; border-bottom: 2px solid #ff6b00; }
    .mag-sidebar-widget ul { list-style: none; padding: 0; margin: 0; }
    .mag-sidebar-widget li { padding: 10px 0; border-bottom: 1px solid #eee; font-size: 14px; }
    .mag-sidebar-widget li a { color: #333; text-decoration: none; }
    .mag-sidebar-widget li a:hover { color: #0066cc; }
  </style>

  <div class="magazine-wrap">
    <div class="mag-topbar">
      <span>{today}</span>
      <div class="socials">
        <a href="https://twitter.com/coinainews" target="_blank" rel="noopener">Twitter</a>
        <a href="https://facebook.com/coinainews" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>

    {trendingPosts.length > 0 && (
      <div class="mag-ticker">
        <span class="ticker-label">Trending</span>
        <div class="ticker-track">
          {[...trendingPosts, ...trendingPosts].map((p) => (
            <a href={`/${p.slug}/`}>{p.title}</a>
          ))}
        </div>
      </div>
    )}

    {heroMain && (
      <section class="mag-hero">
        <div class="mag-hero-main">
          <a href={`/${heroMain.slug}/`}>
            {getPostImage(heroMain.slug) ? (
              <img src={getPostImage(heroMain.slug)} alt={heroMain.title} class="hero-img" />
            ) : (
              <div style="height:400px;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);"></div>
            )}
            <div class="hero-content">
              <span class="hero-cat">{heroMain.categories?.[0] || 'Featured'}</span>
              <h2>{heroMain.title}</h2>
              <span class="hero-date">{heroMain.date}</span>
            </div>
          </a>
        </div>
        <div class="mag-hero-side">
          {heroSide.map((p) => (
            <article>
              <div class="side-thumb">
                {getPostImage(p.slug) ? (
                  <img src={getPostImage(p.slug)} alt={p.title} />
                ) : (
                  <div style="width:100%;height:100%;background:linear-gradient(135deg,#2d1b4e,#1a1a2e);"></div>
                )}
              </div>
              <div class="side-content">
                <span class="side-cat">{p.categories?.[0] || 'News'}</span>
                <h3><a href={`/${p.slug}/`}>{p.title}</a></h3>
                <span class="side-date">{p.date}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="mag-layout-2col">
      <div>
        <h2 class="mag-section-title">
          Latest News
          <a href="/search/">View All →</a>
        </h2>
        <div class="mag-grid">
          {latestPosts.slice(0, 9).map((p) => (
            <article class="mag-card">
              <div class="card-thumb">
                {getPostImage(p.slug) ? (
                  <img src={getPostImage(p.slug)} alt={p.title} loading="lazy" />
                ) : (
                  <div style="width:100%;height:100%;background:linear-gradient(135deg,#2d1b4e,#1a1a2e);"></div>
                )}
              </div>
              <div class="card-body">
                <span class="card-cat">{p.categories?.[0] || 'Crypto'}</span>
                <h3><a href={`/${p.slug}/`}>{p.title}</a></h3>
                <span class="card-date">{p.date}</span>
              </div>
            </article>
          ))}
        </div>

        {Object.entries(catGroups).slice(0, 2).map(([catName, catPosts]) => (
          <div>
            <h2 class="mag-section-title">{catName}</h2>
            <div class="mag-grid" style="margin-bottom:40px;">
              {catPosts.map((p) => (
                <article class="mag-card">
                  <div class="card-thumb">
                    {getPostImage(p.slug) ? (
                      <img src={getPostImage(p.slug)} alt={p.title} loading="lazy" />
                    ) : (
                      <div style="width:100%;height:100%;background:linear-gradient(135deg,#2d1b4e,#1a1a2e);"></div>
                    )}
                  </div>
                  <div class="card-body">
                    <span class="card-cat">{catName}</span>
                    <h3><a href={`/${p.slug}/`}>{p.title}</a></h3>
                    <span class="card-date">{p.date}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>

      <aside>
        <div class="mag-sidebar-widget">
          <h4>🔥 Trending Now</h4>
          <ul>
            {trendingPosts.slice(0, 6).map((p) => (
              <li><a href={`/${p.slug}/`}>{p.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="mag-sidebar-widget">
          <h4>📂 Categories</h4>
          <ul>
            <li><a href="/category/market-news/">Market News</a></li>
            <li><a href="/category/trending-news/">Trending News</a></li>
            <li><a href="/category/crypto-regulations/">Crypto Regulations</a></li>
            <li><a href="/category/crypto/">Crypto</a></li>
          </ul>
        </div>

        <div class="mag-sidebar-widget">
          <h4>🌐 Follow Us</h4>
          <ul>
            <li><a href="https://twitter.com/coinainews" target="_blank" rel="noopener">Twitter / X</a></li>
            <li><a href="https://facebook.com/coinainews" target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
