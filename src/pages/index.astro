---
import Layout from '../layouts/Layout.astro';
import { posts } from '../lib/content';

const latest = posts.slice(-20).reverse();
---

<Layout
  title="CoinAI News — Latest Crypto & AI News"
  description="Latest crypto & AI news"
  bodyClass="home"
  css="home-default"
  js="home-default"
  dir="ltr"
>
  <div style="max-width:900px;margin:0 auto;padding:30px 20px;font-family:Arial,sans-serif;background:#fff;">
    <h1 style="font-size:32px;margin:0 0 30px;color:#111;border-bottom:2px solid #333;padding-bottom:15px;">
      Latest Crypto &amp; AI News
    </h1>
    <div>
      {latest.map((p) => (
        <article style="border-bottom:1px solid #eee;padding:20px 0;">
          <h2 style="margin:0 0 10px;font-size:22px;line-height:1.3;">
            <a href={`/${p.slug}/`} style="text-decoration:none;color:#0066cc;">
              {p.title}
            </a>
          </h2>
          {p.excerpt && <p style="color:#555;margin:0 0 8px;font-size:15px;line-height:1.5;">{p.excerpt}</p>}
          <small style="color:#999;font-size:13px;">{p.date}</small>
        </article>
      ))}
    </div>
  </div>
</Layout>
