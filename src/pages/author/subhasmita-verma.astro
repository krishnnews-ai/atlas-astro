---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../lib/content';

const authorPosts = posts.slice(0, 30);

const POST_HTML = import.meta.glob('../../generated/posts/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

function getPostImage(slug: string): string {
  const key = Object.keys(POST_HTML).find((k) => k.endsWith('/' + slug + '.html'));
  if (!key) return '';
  const html = POST_HTML[key];
  const match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
  return match ? match[1] : '';
}

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.coinainews.com/author/subhasmita-verma/#person",
    "name": "Subhasmita Verma",
    "url": "https://www.coinainews.com/author/subhasmita-verma/",
    "image": "https://www.coinainews.com/authors/subhasmita-mishra.jpg",
    "jobTitle": "Crypto & AI News Editor",
    "description": "Subhasmita Verma covers cryptocurrency, blockchain, and AI developments for CoinAI News.",
    "sameAs": [
      "https://x.com/subhashmitlied",
      "https://www.linkedin.com/in/subhasmita-mishra-8058ba71/"
    ],
    "worksFor": {
      "@type": "Organization",
      "name": "CoinAI News",
      "url": "https://www.coinainews.com"
    }
  }
};
---

<Layout
  title="Subhasmita Verma — Author at CoinAI News"
  description="Articles by Subhasmita Verma, Crypto & AI News Editor at CoinAI News."
  bodyClass="author-page"
  css="home-default"
  dir="ltr"
>
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />

  <style is:inline>
    .author-wrap { max-width: 1100px; margin: 0 auto; padding: 40px 20px; font-family: Poppins, sans-serif; }
    .author-hero { display: flex; align-items: center; gap: 24px; padding: 30px; background: linear-gradient(135deg, #fff5e6 0%, #fff 100%); border-radius: 12px; margin-bottom: 40px; border: 1px solid #ffe0b2; }
    .author-avatar { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 3px solid #ff6b00; }
    .author-info h1 { font-size: 28px; font-weight: 700; margin: 0 0 8px; color: #111; }
    .author-info .author-role { font-size: 14px; color: #ff6b00; font-weight: 600; margin-bottom: 12px; }
    .author-info p { font-size: 14px; color: #555; line-height: 1.6; margin: 0 0 12px; }
    .author-socials a { color: #ff6b00; text-decoration: none; margin-right: 16px; font-weight: 600; font-size: 13px; }
    .author-socials a:hover { text-decoration: underline; }
    
    .author-posts-title { font-size: 22px; font-weight: 700; margin: 0 0 20px; padding-bottom: 12px; border-bottom: 2px solid #ff6b00; color: #111; }
    .author-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .author-card { background: #fff; border: 1px solid #f0f0f0; border-radius: 8px; overflow: hidden; transition: box-shadow 0.2s; }
    .author-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .author-card .card-thumb { height: 160px; overflow: hidden; background: #f0f0f0; }
    .author-card .card-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .author-card .card-body { padding: 16px; }
    .author-card .card-cat { font-size: 10px; color: #ff6b00; font-weight: 600; text-transform: uppercase; }
    .author-card h3 { font-size: 15px; font-weight: 600; margin: 6px 0 8px; line-height: 1.4; }
    .author-card h3 a { color: #111; text-decoration: none; }
    .author-card h3 a:hover { color: #0066cc; }
    .author-card .card-date { font-size: 11px; color: #999; }
    @media (max-width: 600px) { .author-hero { flex-direction: column; text-align: center; } }
  </style>

  <div class="author-wrap">
    <div class="author-hero">
      <img src="/authors/subhasmita-mishra.jpg" alt="Subhasmita Verma" class="author-avatar" />
      <div class="author-info">
        <h1>Subhasmita Verma</h1>
        <div class="author-role">Crypto & AI News Editor</div>
        <p>Subhasmita Verma covers cryptocurrency, blockchain, and AI developments for CoinAI News. She specializes in market analysis, regulatory updates, and emerging Web3 technologies.</p>
        <div class="author-socials">
          <a href="https://x.com/subhashmitlied" target="_blank" rel="noopener">Twitter / X</a>
          <a href="https://www.linkedin.com/in/subhasmita-mishra-8058ba71/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>

    <h2 class="author-posts-title">Articles by Subhasmita Verma</h2>
    <div class="author-grid">
      {authorPosts.map((p) => (
        <article class="author-card">
          <div class="card-thumb">
            {getPostImage(p.slug) ? (
              <img src={getPostImage(p.slug)} alt={p.title} loading="lazy" />
            ) : (
              <div style="width:100%;height:100%;background:linear-gradient(135deg,#2d1b4e,#1a1a2e);"></div>
            )}
          </div>
          <div class="card-body">
            <span class="card-cat">{p.categories?.[0] || 'News'}</span>
            <h3><a href={`/${p.slug}/`}>{p.title}</a></h3>
            <span class="card-date">{p.date}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
