---
import Layout from '../layouts/Layout.astro';
import { postDoc, posts } from '../lib/content';

const DUMMY_SLUGS = [
  'blog-post',
  'coconut-curry-soup-with-chickpeas',
  'dark-chocolate-self-saucing-pudding',
  'delicious-chicken-meatball-soup',
  'fairy-potion-summer-fruit-drink',
  'fashion-tips-trends-and-celebrity-style',
  'fruit-yogurt-easy-homemade-fruit-drink',
  'healthy-chicken-and-rice-soup',
  'melt-and-mix-chocolate-and-ginger-mud-cake',
  'pecan-chocolate-bread-and-butter',
  'refreshing-summer-fruit-drink',
  'spicy-crispy-chicken-burger-recipe',
  'spiked-strawberry-slushies-for-a-crowd',
  'tomato-bisque-with-fried-cheese',
  'tortellini-soup-with-italian-sausage-and-kale',
  'vegan-chocolate-avocado-milkshakes',
  'wild-mushroom-chowder-with-leeks',
  'why-do-restaurant-burgers-taste-better',
  'a-mild-sweet-fruit-with-a-fibrous-center',
  'always-keep-your-drone-within-the-vlos',
  'comfortable-pairs-of-sneakers-to-walk-all-day',
  'essential-tech-tips-for-your-business',
  'finally-found-a-work-computer-setup-thats-practically-perfect',
  'for-good-results-must-be-make-good-plan',
  'gadgets-that-will-upgrade-your-home',
  'headsets-are-better-if-youre-playing-games',
  'hot-new-releases-in-audio-headphones',
  'how-to-do-the-superman-standing-exercise',
  'how-to-organize-and-write-content-for',
  'in-fact-certainly-influenced-seldes-the-leftist-journalist-i-f-stone',
  'laptops-tend-to-be-smaller-than-desktops',
  'laugh-cry-and-learn-within-virtual-reality',
  'make-your-gaming-setup-look-better',
  'make-your-phone-feel-new-again',
  'mistakes-you-might-be-making-with-your-watch',
  'mobile-camera-makes-a-huge-leap-in-quality',
  'rugby-african-ations-are-singing-to-save-their-wildlif',
  'surprising-benefits-of-honeydew-melon',
  'the-inbound-marketing-methodology-method-of-drawing-the-right',
  'the-secret-of-buzzfeeds-success-has-a-lot-to-do-with-the-image-heavy',
  'there-are-several-differences-between-outbound',
  'tips-to-ensure-you-always-look-stylish',
  'top-12-health-benefits-of-eating-grapes',
  'top-classic-style-inspiration-ideas',
  'top-mens-fashion-trends-from-spring',
  'vr-headset-virtual-reality-glasses',
  'will-humans-be-able-to-live-in-mars-in-the-future',
  'winter-dressing- tips-when-its-really-cold-out'
];

export function getStaticPaths() {
  if (!posts || !Array.isArray(posts)) return [];
  return posts
    .filter((p: any) => p && p.slug)
    .filter((p: any) => !DUMMY_SLUGS.includes(p.slug))
    .map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const doc = postDoc(slug!);
const post = posts.find((p) => p.slug === slug);

function generateDescription(title: string, excerpt?: string, category?: string): string {
  if (excerpt && excerpt.trim().length > 60) {
    return excerpt.trim().slice(0, 155).replace(/\s+\S*$/, '') + '...';
  }
  const cleanTitle = title.replace(/[—–-]/g, ' ').replace(/\s+/g, ' ').trim();
  const cat = category || 'crypto';
  const templates = [
    `${cleanTitle}. Get the latest ${cat} news, market analysis, and expert insights from CoinAI News.`,
    `Read about ${cleanTitle.toLowerCase()} — breaking ${cat} news and in-depth coverage on CoinAI News.`,
    `${cleanTitle}. Stay updated with the latest ${cat} developments, trends, and analysis on CoinAI News.`,
    `Latest update: ${cleanTitle}. Fresh ${cat} news, insights, and market coverage from CoinAI News.`,
    `${cleanTitle} — your trusted source for breaking ${cat} news and analysis. Read more on CoinAI News.`,
  ];
  const idx = cleanTitle.length % templates.length;
  const desc = templates[idx];
  return desc.length > 155 ? desc.slice(0, 152) + '...' : desc;
}

const category = post?.categories?.[0] || 'Crypto';
const description = generateDescription(doc.title, post?.excerpt, category);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  ...(post?.categories?.[0] ? [{ name: post.categories[0], url: `/category/${post.categories[0].toLowerCase().replace(/\s+/g, '-')}/` }] : []),
  { name: doc.title }
];

const imageUrl = post?.cover
  ? (post.cover.startsWith('http') ? post.cover : `https://www.coinainews.com${post.cover}`)
  : 'https://www.coinainews.com/og-default.jpg';
---

<Layout
  {...doc}
  description={description}
  canonical={`/${slug}/`}
  image={imageUrl}
  type="article"
  publishedTime={post?.date ? new Date(post.date).toISOString() : new Date().toISOString()}
  modifiedTime={post?.date ? new Date(post.date).toISOString() : new Date().toISOString()}
  author="Subhasmita Verma"
  category={category}
  breadcrumbs={breadcrumbs}
  isArticle={true}
>
  <Fragment set:html={doc.main} />

  <div class="author-box">
    <img src="/authors/subhasmita-mishra.jpg" alt="Subhasmita Verma" class="author-box-img" />
    <div class="author-box-info">
      <div class="author-box-label">Written by</div>
      <h3><a href="/author/subhasmita-verma/">Subhasmita Verma</a></h3>
      <div class="author-box-role">Crypto & AI News Editor</div>
      <p>Subhasmita Verma covers cryptocurrency, blockchain, and AI developments for CoinAI News. She specializes in market analysis, regulatory updates, and emerging Web3 technologies.</p>
      <div class="author-box-socials">
        <a href="https://x.com/subhashmitlied" target="_blank" rel="noopener">Twitter / X</a>
        <a href="https://www.linkedin.com/in/subhasmita-mishra-8058ba71/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>

  <style is:inline>
    .author-box {
      max-width: 800px;
      margin: 50px auto 30px;
      padding: 24px;
      background: linear-gradient(135deg, #fff5e6 0%, #fff 100%);
      border: 1px solid #ffe0b2;
      border-radius: 12px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      font-family: Poppins, sans-serif;
    }
    .author-box-img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 3px solid #ff6b00;
    }
    .author-box-info { flex: 1; }
    .author-box-label {
      font-size: 11px;
      color: #ff6b00;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }
    .author-box-info h3 {
      margin: 0 0 4px;
      font-size: 20px;
      font-weight: 700;
    }
    .author-box-info h3 a {
      color: #111;
      text-decoration: none;
    }
    .author-box-info h3 a:hover { color: #ff6b00; }
    .author-box-role {
      font-size: 13px;
      color: #ff6b00;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .author-box-info p {
      font-size: 13px;
      color: #555;
      line-height: 1.6;
      margin: 0 0 12px;
    }
    .author-box-socials a {
      color: #ff6b00;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      margin-right: 16px;
    }
    .author-box-socials a:hover { text-decoration: underline; }
    @media (max-width: 600px) {
      .author-box { flex-direction: column; text-align: center; align-items: center; }
    }
  </style>
</Layout>
